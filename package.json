{
    "name": "bushiweb.dev",
    "private": true,
    "version": "0.0.4",
    "type": "module",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "prepare": "husky",
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint:unused": "next lint",
        "test": "vitest",
        "check:lint": "eslint . --max-warnings 0 --cache",
        "check:format": "prettier . --write --cache",
        "check:csslint": "stylelint \"**/*.css\" --cache --fix --max-warnings 0",
        "check:all": "pnpm check:format && pnpm check:lint && pnpm check:csslint",
        "docker:build": "docker build -t bushiweb .",
        "docker:run": "docker run --rm -d -p 3000:3000 --name bushiweb bushiweb",
        "docker:kill": "docker kill bushiweb",
        "docker:tag": "docker image tag bushiweb bushiweb/bushiweb.dev:%npm_package_version%",
        "docker:push": "docker push bushiweb/bushiweb.dev:%npm_package_version%"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^6.6.0",
        "@fortawesome/free-brands-svg-icons": "^6.6.0",
        "@fortawesome/free-regular-svg-icons": "^6.6.0",
        "@fortawesome/free-solid-svg-icons": "^6.6.0",
        "@fortawesome/react-fontawesome": "^0.2.2",
        "@next/eslint-plugin-next": "^14.2.5",
        "@tailwindcss/container-queries": "^0.1.1",
        "@tailwindcss/forms": "^0.5.7",
        "clsx": "^2.1.1",
        "eslint-plugin-react": "^7.34.4",
        "next": "^14.2.5",
        "react": "^18.2.0",
        "react-aria-components": "^1.3.1",
        "react-dom": "^18.2.0",
        "sharp": "^0.33.4",
        "tailwindcss-react-aria-components": "^1.1.4"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.1.0",
        "@testing-library/jest-dom": "^6.4.6",
        "@testing-library/react": "^16.0.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/node": "^20.14.11",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.2.1",
        "commitizen": "^4.3.0",
        "cssnano": "^7.0.4",
        "cz-conventional-changelog": "^3.3.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-jsx-a11y": "^6.9.0",
        "eslint-plugin-react-hooks": "^4.6.2",
        "husky": "^9.0.11",
        "jsdom": "^24.1.0",
        "lint-staged": "^15.2.7",
        "postcss": "^8.4.39",
        "postcss-preset-env": "^9.5.14",
        "prettier": "^3.3.3",
        "prettier-plugin-nginx": "^1.0.3",
        "prettier-plugin-prisma": "^5.0.0",
        "prettier-plugin-tailwindcss": "^0.6.5",
        "stylelint": "^16.6.1",
        "stylelint-config-standard": "^36.0.0",
        "stylelint-no-unresolved-module": "^2.2.2",
        "stylelint-plugin-defensive-css": "^1.0.4",
        "stylelint-plugin-logical-css": "^1.2.1",
        "stylelint-rem-over-px": "^1.0.1",
        "stylelint-use-nesting": "^5.1.1",
        "tailwindcss": "^3.4.6",
        "typescript": "^5.5.3",
        "typescript-eslint": "^7.13.0",
        "vite-tsconfig-paths": "^4.3.2",
        "vitest": "^2.0.3"
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog",
            "maxHeaderWidth": 50,
            "maxLineWidth": 72,
            "defaultType": "feat",
            "types": {
                "✨feat": {
                    "description": "A new feature",
                    "title": "Features"
                },
                "🐛fix": {
                    "description": "A bug fix",
                    "title": "Bug fix"
                },
                "📚docs": {
                    "description": "Changes made only to the documentation",
                    "title": "Documentation"
                },
                "🎨style": {
                    "description": "Alteration that don't change the code intent (white space, formatting, missing semi-colons, ...)",
                    "title": "Code styling"
                },
                "♻️ refactor": {
                    "description": "An update to the code that neither adds features nor fixes bugs",
                    "title": "Code refactoring"
                },
                "⚡perf": {
                    "description": "A performance enhancing tweak to the code",
                    "title": "Performance improvements"
                },
                "🧪test": {
                    "description": "Addition or update of tests",
                    "title": "Tests"
                },
                "⚒️ build": {
                    "description": "Modification to the build system or to external dependencies",
                    "title": "Builds"
                },
                "🚀ci": {
                    "description": "Modification to the CI configuration scripts and files",
                    "title": "Continuous Integration"
                },
                "⚙️ chore": {
                    "description": "Other updates that don't alter the test or source files",
                    "title": "Chores"
                },
                "🗑️ revert": {
                    "description": "Reverts a previous commit",
                    "title": "Reverts commit"
                },
                "🎉init": {
                    "description": "Initial commit",
                    "title": "Initial commit"
                },
                "📦metadata": {
                    "description": "Update to the metadata (package.json, ...)",
                    "title": "Update metadata"
                },
                "⏫dependencies": {
                    "description": "Update to dependencies",
                    "title": "Dependencies"
                },
                "⬆️ peerDependencies": {
                    "description": "Update to peer dependencies",
                    "title": "Peer dependencies"
                },
                "🔼devDependencies": {
                    "description": "Update to dev dependencies",
                    "title": "Dev dependencies"
                },
                "🏷️ release": {
                    "description": "Release a new version",
                    "title": "Release"
                }
            }
        }
    }
}

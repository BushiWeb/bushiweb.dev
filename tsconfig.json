{
    "compilerOptions": {
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "target": "ESNext",
        "allowJs": true,
        "skipLibCheck": true,
        "module": "ESNext",
        "incremental": true,
        "noEmit": true,
        "esModuleInterop": true,
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "strict": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "baseUrl": ".",
        "paths": {
            "@public/*": ["./public/*"],
            "@tests/*": ["./src/shared/tests/*"],
            "@/*": ["./src/*"]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        "next.config.js",
        "vitest-setup.ts",
        "vitest.config.ts",
        "postcss.config.js",
        "stylelint.config.js",
        "eslint.config.js"
    ],
    "exclude": ["node_modules"]
}
